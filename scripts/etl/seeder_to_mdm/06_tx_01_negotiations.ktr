      <from>Negotiations CSV Input</from>
      <to>Negotiations Table Output</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>Negotiations CSV Input</name>
    <type>CsvInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename>${Internal.Transformation.Filename.Directory}/../../../seeder/transaction/01_negotiations.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>Y</newline_possible>
    <format/>
    <encoding/>
    <fields>
      <field><name>seller_id</name><type>Integer</type><format>#</format><length>15</length><precision>0</precision><trim_type>none</trim_type></field>
      <field><name>buyer_id</name><type>Integer</type><format>#</format><length>15</length><precision>0</precision><trim_type>none</trim_type></field>
      <field><name>product_id</name><type>Integer</type><format>#</format><length>15</length><precision>0</precision><trim_type>none</trim_type></field>
      <field><name>agreed_price_offer</name><type>Integer</type><format>#</format><length>15</length><precision>0</precision><trim_type>none</trim_type></field>
      <field><name>agreed_unit_id</name><type>Integer</type><format>#</format><length>15</length><precision>0</precision><trim_type>none</trim_type></field>
      <field><name>agreed_quantity_offer</name><type>Integer</type><format>#</format><length>15</length><precision>0</precision><trim_type>none</trim_type></field>
      <field><name>valid_until</name><type>Date</type><format>yyyy-MM-dd HH:mm:ss</format><length>19</length><precision>-1</precision><trim_type>none</trim_type></field>
      <field><name>status</name><type>String</type><length>10</length><precision>-1</precision><trim_type>none</trim_type></field>
      <field><name>created_at</name><type>Date</type><format>yyyy-MM-dd HH:mm:ss</format><length>19</length><precision>-1</precision><trim_type>none</trim_type></field>
      <field><name>updated_at</name><type>Date</type><format>yyyy-MM-dd HH:mm:ss</format><length>19</length><precision>-1</precision><trim_type>none</trim_type></field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input/><output/></remotesteps>
    <GUI><xloc>224</xloc><yloc>224</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Negotiations Table Output</name>
    <type>ExecSQL</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>panenku_postgres_mdm_hub</connection>
    <schema>transaction</schema>
    <table>negotiations</table>
    <execute_each_row>Y</execute_each_row>
    <single_statement>Y</single_statement>
    <replace_variables>Y</replace_variables>
    <quoteString>N</quoteString>
    <sql>INSERT INTO transaction.negotiations (seller_id, buyer_id, product_id, agreed_price_offer, agreed_unit_id, agreed_quantity_offer, valid_until, status, created_at, updated_at)
VALUES ('?', '?', '?', '?', '?', '?', '?', '?', '?', '?');</sql>
    <set_params>N</set_params>
    <insert_field/>
    <update_field/>
    <delete_field/>
    <read_field/>
    <arguments>
      <argument><name>seller_id</name></argument>
      <argument><name>buyer_id</name></argument>
      <argument><name>product_id</name></argument>
      <argument><name>agreed_price_offer</name></argument>
      <argument><name>agreed_unit_id</name></argument>
      <argument><name>agreed_quantity_offer</name></argument>
      <argument><name>valid_until</name></argument>
      <argument><name>status</name></argument>
      <argument><name>created_at</name></argument>
      <argument><name>updated_at</name></argument>
    </arguments>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input/><output/></remotesteps>
    <GUI><xloc>448</xloc><yloc>224</yloc><draw>Y</draw></GUI>
  </step>
