  <order>
  </order>
  <step>
    <name>Load Fact Order Items</name>
    <type>ExecSQL</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>panenku_sqlserver_dw</connection>
    <sql>MERGE warehouse.dbo.fact_order_items AS target
USING (
    SELECT
        oi.order_item_id,
        CAST(CONVERT(VARCHAR(8), o.created_at, 112) AS INT) AS date_id,
        COALESCE(bu.user_key, 0) AS buyer_key,
        COALESCE(su.user_key, 0) AS seller_key,
        COALESCE(op.province_key, 0) AS origin_province_key,
        COALESCE(dp.province_key, 0) AS destination_province_key,
        COALESCE(pr.product_key, 0) AS product_key,
        oi.order_item_status_id,
        ROUND(oi.quantity * CASE WHEN u.name = 'Kilogram' THEN 1 WHEN u.name = 'Gram' THEN 0.001
                 WHEN u.name = 'Ton' THEN 1000 WHEN u.name = 'Kuintal' THEN 100
                 WHEN u.name = 'Liter' THEN 1 WHEN u.name = 'Ons' THEN 0.1
                 ELSE 1 END, 2) AS quantity_kg,
        ROUND(oi.unit_price / NULLIF(CASE WHEN u.name = 'Kilogram' THEN 1 WHEN u.name = 'Gram' THEN 0.001
                 WHEN u.name = 'Ton' THEN 1000 WHEN u.name = 'Kuintal' THEN 100
                 WHEN u.name = 'Liter' THEN 1 WHEN u.name = 'Ons' THEN 0.1
                 ELSE 1 END, 0), 2) AS price_per_kg,
        oi.discount,
        oi.subtotal AS total_amount,
        CASE WHEN sp.province_id != sh.destination_province_id THEN 1 ELSE 0 END AS is_interprovince
    FROM StagingDB.dbo.stg_order_items oi
    JOIN StagingDB.dbo.stg_orders o ON oi.order_id = o.order_id
    JOIN StagingDB.dbo.stg_shipments sh ON o.shipment_id = sh.shipment_id
    LEFT JOIN StagingDB.dbo.stg_seller_profiles sp ON o.seller_id = sp.user_id
    JOIN StagingDB.dbo.stg_units u ON oi.unit_id = u.id
    LEFT JOIN warehouse.dbo.dim_users bu ON o.buyer_id = bu.user_id
    LEFT JOIN warehouse.dbo.dim_users su ON o.seller_id = su.user_id
    LEFT JOIN warehouse.dbo.dim_province op ON sp.province_id = op.province_id
    LEFT JOIN warehouse.dbo.dim_province dp ON sh.destination_province_id = dp.province_id
    LEFT JOIN warehouse.dbo.dim_products pr ON oi.product_id = pr.product_id
) AS source
ON target.order_item_id = source.order_item_id
WHEN MATCHED THEN UPDATE SET
    date_id = source.date_id,
    buyer_key = source.buyer_key,
    seller_key = source.seller_key,
    origin_province_key = source.origin_province_key,
    destination_province_key = source.destination_province_key,
    product_key = source.product_key,
    order_item_status_id = source.order_item_status_id,
    quantity_kg = source.quantity_kg,
    price_per_kg = source.price_per_kg,
    discount = source.discount,
    total_amount = source.total_amount,
    is_interprovince = source.is_interprovince
WHEN NOT MATCHED THEN INSERT (
    order_item_id, date_id, buyer_key, seller_key, origin_province_key,
    destination_province_key, product_key, order_item_status_id, quantity_kg,
    price_per_kg, discount, total_amount, is_interprovince
) VALUES (
    source.order_item_id, source.date_id, source.buyer_key, source.seller_key, source.origin_province_key,
    source.destination_province_key, source.product_key, source.order_item_status_id, source.quantity_kg,
    source.price_per_kg, source.discount, source.total_amount, source.is_interprovince
);</sql>
