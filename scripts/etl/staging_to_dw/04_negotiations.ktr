  <order>
  </order>
  <step>
    <name>Load Fact Negotiations</name>
    <type>ExecSQL</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>panenku_sqlserver_dw</connection>
    <sql>MERGE warehouse.dbo.fact_negotiations AS target
USING (
    SELECT
        n.negotiation_id,
        COALESCE(bu.user_key, 0) AS buyer_key,
        COALESCE(su.user_key, 0) AS seller_key,
        COALESCE(p.product_key, 0) AS product_key,
        n.status,
        ROUND(n.agreed_quantity 
            * CASE WHEN au.name = 'Kilogram' THEN 1 WHEN au.name = 'Gram' THEN 0.001
                   WHEN au.name = 'Ton' THEN 1000 WHEN au.name = 'Kuintal' THEN 100
                   WHEN au.name = 'Liter' THEN 1 WHEN au.name = 'Ons' THEN 0.1
                   ELSE 1 END, 2) AS agreed_quantity_kg,
        ROUND(n.initial_offer_price / NULLIF(
            CASE WHEN pu.name = 'Kilogram' THEN 1 WHEN pu.name = 'Gram' THEN 0.001
                 WHEN pu.name = 'Ton' THEN 1000 WHEN pu.name = 'Kuintal' THEN 100
                 WHEN pu.name = 'Liter' THEN 1 WHEN pu.name = 'Ons' THEN 0.1
                 ELSE 1 END, 0), 2) AS initial_offered_price_per_kg,
        ROUND(n.agreed_price / NULLIF(
            n.agreed_quantity 
            * CASE WHEN au.name = 'Kilogram' THEN 1 WHEN au.name = 'Gram' THEN 0.001
                   WHEN au.name = 'Ton' THEN 1000 WHEN au.name = 'Kuintal' THEN 100
                   WHEN au.name = 'Liter' THEN 1 WHEN au.name = 'Ons' THEN 0.1
                   ELSE 1 END, 0), 2) AS agreed_price_per_kg,
        ROUND(
            (n.initial_offer_price / NULLIF(
                CASE WHEN pu.name = 'Kilogram' THEN 1 WHEN pu.name = 'Gram' THEN 0.001
                     WHEN pu.name = 'Ton' THEN 1000 WHEN pu.name = 'Kuintal' THEN 100
                     WHEN pu.name = 'Liter' THEN 1 WHEN pu.name = 'Ons' THEN 0.1
                     ELSE 1 END, 0))
            - (n.agreed_price / NULLIF(
                n.agreed_quantity 
                * CASE WHEN au.name = 'Kilogram' THEN 1 WHEN au.name = 'Gram' THEN 0.001
                       WHEN au.name = 'Ton' THEN 1000 WHEN au.name = 'Kuintal' THEN 100
                       WHEN au.name = 'Liter' THEN 1 WHEN au.name = 'Ons' THEN 0.1
                       ELSE 1 END, 0))
        , 2) AS price_difference_per_kg
    FROM StagingDB.dbo.stg_negotiations n
    LEFT JOIN StagingDB.dbo.stg_products sp ON n.product_id = sp.product_id
    LEFT JOIN StagingDB.dbo.stg_units pu ON sp.unit_id = pu.id
    LEFT JOIN StagingDB.dbo.stg_units au ON n.agreed_unit_id = au.id
    LEFT JOIN warehouse.dbo.dim_users bu ON n.buyer_id = bu.user_id
    LEFT JOIN warehouse.dbo.dim_users su ON n.seller_id = su.user_id
    LEFT JOIN warehouse.dbo.dim_products p ON n.product_id = p.product_id
) AS source
ON target.negotiation_id = source.negotiation_id
WHEN MATCHED THEN UPDATE SET
    buyer_key = source.buyer_key,
    seller_key = source.seller_key,
    product_key = source.product_key,
    status = source.status,
    agreed_quantity_kg = source.agreed_quantity_kg,
    initial_offered_price_per_kg = source.initial_offered_price_per_kg,
    agreed_price_per_kg = source.agreed_price_per_kg,
    price_difference_per_kg = source.price_difference_per_kg
WHEN NOT MATCHED THEN INSERT (
    negotiation_id, buyer_key, seller_key, product_key, status,
    agreed_quantity_kg, initial_offered_price_per_kg, agreed_price_per_kg,
    price_difference_per_kg
) VALUES (
    source.negotiation_id, source.buyer_key, source.seller_key, source.product_key, source.status,
    source.agreed_quantity_kg, source.initial_offered_price_per_kg, source.agreed_price_per_kg,
    source.price_difference_per_kg
);</sql>
